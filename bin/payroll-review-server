#!/usr/bin/env ruby
# frozen_string_literal: true

abort "Review app only" unless ENV["PAYROLL_REVIEW_APP"] == "true" &&
  ENV["APP_BASE_URL"] == "https://miru-payroll-pr-2459.onrender.com"

ENV["RAILS_ENV"] = "production"
require_relative "../config/environment"

abort "Review database only" unless ActiveRecord::Base.connection_db_config.database == "miru_payroll_review"
abort "Review storage only" unless Rails.application.config.active_storage.service == :local

ActionMailer::Base.perform_deliveries = false
ActiveJob::Base.queue_adapter = :test

if ActiveRecord::Base.connection.data_sources.empty?
  load Rails.root.join("db/schema.rb")
end
ActiveRecord::Tasks::DatabaseTasks.migrate

Company.transaction do
  company = Company.find_or_initialize_by(id: 1)
  abort "Unexpected review data" if company.persisted? && company.name != "Miru Payroll Review"

  company.update!(name: "Miru Payroll Review", country: "IN", base_currency: "INR",
    standard_price: 0, timezone: "Asia/Kolkata", billing_exempt: true, date_format: "DD-MM-YYYY")
  %w[admin employee colleague].each_with_index do |role, index|
    user = User.find_or_initialize_by(email: "payroll-#{role}@example.test")
    next if user.persisted?

    user.assign_attributes(first_name: role.capitalize, last_name: "Review", current_workspace: company,
      password: ENV.fetch("PAYROLL_REVIEW_PASSWORD"), confirmed_at: Time.current,
      jti: SecureRandom.uuid, unique_session_id: SecureRandom.uuid)
    user.save!(validate: false)
    Employment.create!(company:, user:, joined_at: Date.new(2025, 1, 1), resigned_at: nil,
      employee_id: "QA-#{index + 1}", designation: "Consultant", employment_type: "consultant")
    user.add_role(role == "admin" ? :owner : :employee, company)
  end
end

# Restore only this known synthetic PDF after the free review instance is replaced.
review_pdf = <<~PDF.chomp
  %PDF-1.4
  1 0 obj
  << /Type /Catalog /Pages 2 0 R >>
  endobj
  2 0 obj
  << /Type /Pages /Kids [3 0 R] /Count 1 >>
  endobj
  3 0 obj
  << /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] >>
  endobj
  trailer
  << /Root 1 0 R >>
  %%EOF
PDF
ActiveStorage::Blob.where(service_name: "local", content_type: "application/pdf", checksum: Digest::MD5.base64digest(review_pdf)).find_each do |blob|
  blob.service.upload(blob.key, StringIO.new(review_pdf), checksum: blob.checksum) unless blob.service.exist?(blob.key)
end

require "rails/command"
require "rails/commands/server/server_command"
Rails::Server.new(Host: "0.0.0.0", Port: ENV.fetch("PORT", "10000").to_i,
  environment: "production", config: "config.ru").start
