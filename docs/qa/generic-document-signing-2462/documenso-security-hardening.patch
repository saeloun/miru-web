+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { createTransport } from 'nodemailer';
+
+import { MailChannelsTransport } from '../../packages/email/transports/mailchannels.ts';
+
+const requests = [];
+let responseStatus = 202;
+const server = createServer(async (request, response) => {
+  const chunks = [];
+  for await (const chunk of request) {
+    chunks.push(chunk);
+  }
+  requests.push({ method: request.method, body: JSON.parse(Buffer.concat(chunks).toString()) });
+  response.writeHead(responseStatus, { 'Content-Type': 'application/json' });
+  response.end(JSON.stringify({ message: 'synthetic transport response' }));
+});
+
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+try {
+  const transport = createTransport(MailChannelsTransport.makeTransport({
+    endpoint: `http://127.0.0.1:${server.address().port}/send`,
+  }));
+  const message = {
+    from: { name: 'Synthetic Sender', address: 'sender@example.test' },
+    to: 'Consultants: First <first@example.test>, Second <second@example.test>;',
+    cc: 'copy@example.test',
+    bcc: 'private@example.test',
+    replyTo: { name: 'Reply Desk', address: 'reply@example.test' },
+    subject: 'Synthetic transport check',
+    text: 'No external email is sent.',
+    headers: { 'X-Synthetic-Check': 'yes' },
+  };
+  const result = await transport.sendMail(message);
+  assert.deepEqual(result.envelope, {
+    from: 'sender@example.test',
+    to: ['first@example.test', 'second@example.test', 'copy@example.test', 'private@example.test'],
+  });
+  assert.deepEqual(result.accepted, result.envelope.to);
+  assert.match(result.messageId, /^<.+>$/);
+  const request = requests[0];
+  assert.equal(request.method, 'POST');
+  assert.deepEqual(request.body.from, { email: 'sender@example.test', name: 'Synthetic Sender' });
+  assert.deepEqual(request.body.reply_to, { email: 'reply@example.test', name: 'Reply Desk' });
+  assert.deepEqual(request.body.personalizations[0].to, [
+    { email: 'first@example.test', name: 'First' },
+    { email: 'second@example.test', name: 'Second' },
+  ]);
+  assert.equal(request.body.personalizations[0].cc[0].email, 'copy@example.test');
+  assert.equal(request.body.personalizations[0].bcc[0].email, 'private@example.test');
+  assert.equal(request.body.headers['X-Synthetic-Check'], 'yes');
+  assert.equal(request.body.content[0].value, message.text);
+
+  responseStatus = 500;
+  await assert.rejects(transport.sendMail(message), /MailChannels error: synthetic transport response/);
+  await assert.rejects(transport.sendMail({ from: message.from, text: message.text }), /Missing required fields/);
+  assert.equal(requests.length, 2);
+  console.log(JSON.stringify({ transport: 'custom HTTP', acceptedRecipients: 4, errorPaths: 2 }));
+} finally {
+  await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+}
diff --git a/scripts/security/runtime-dependencies-check.mjs b/scripts/security/runtime-dependencies-check.mjs
new file mode 100644
index 0000000..29694c2
--- /dev/null
+++ b/scripts/security/runtime-dependencies-check.mjs
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import { existsSync, lstatSync, readdirSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const minimums = {
+  'follow-redirects': [1, 16, 2],
+  systeminformation: [5, 33, 16],
+  qs: [6, 16, 1],
+  '@hono/node-server': [2, 1, 3],
+  glob: [14, 0, 2],
+  minimatch: [11, 0, 1],
+  satori: [0, 33, 5],
+  fflate: [0, 8, 3],
+};
+const versions = {};
+const atLeast = (actual, minimum) => {
+  for (let index = 0; index < 3; index += 1) {
+    if (actual[index] !== minimum[index]) {
+      return actual[index] > minimum[index];
+    }
+  }
+  return true;
+};
+const inspect = (directory) => {
+  if (!existsSync(directory) || !lstatSync(directory).isDirectory()) {
+    return;
+  }
+  for (const entry of readdirSync(directory, { withFileTypes: true })) {
+    if (!entry.isDirectory() || entry.name.startsWith('.')) {
+      continue;
+    }
+    const path = join(directory, entry.name);
+    if (entry.name.startsWith('@')) {
+      inspect(path);
+      continue;
+    }
+    const { name, version } = JSON.parse(readFileSync(join(path, 'package.json'), 'utf8'));
+    if (name in minimums) {
+      assert.match(version, /^\d+\.\d+\.\d+$/);
+      const actual = version.split('.').map(Number);
+      if (!((name === 'glob' && actual[0] < 9) || (name === 'minimatch' && actual[0] < 7))) {
+        const minimum =
+          name === 'fflate' && actual[0] === 0 && actual[1] >= 4 && actual[1] < 8
+            ? [0, actual[1], { 4: 9, 5: 4, 6: 11, 7: 5 }[actual[1]]]
+            : minimums[name];
+        assert.ok(atLeast(actual, minimum), `${name}@${version} is below the security floor`);
+        versions[name] ??= new Set();
+        versions[name].add(version);
+      }
+    }
+    if (existsSync(join(path, 'node_modules'))) {
+      inspect(join(path, 'node_modules'));
+    }
+  }
+};
+const root = fileURLToPath(new URL('../../', import.meta.url));
+inspect(join(root, 'node_modules'));
+for (const group of ['apps', 'packages']) {
+  const directory = join(root, group);
+  if (!existsSync(directory) || !lstatSync(directory).isDirectory()) {
+    continue;
+  }
+  for (const workspace of readdirSync(directory, { withFileTypes: true })) {
+    if (workspace.isDirectory()) {
+      inspect(join(directory, workspace.name, 'node_modules'));
+    }
+  }
+}
+assert.deepEqual(Object.keys(versions).sort(), Object.keys(minimums).sort());
+console.log(
+  JSON.stringify({
+    runtimeDependencyVersions: Object.fromEntries(
+      Object.entries(versions).map(([name, found]) => [name, [...found].sort()]),
+    ),
+  }),
+);
diff --git a/scripts/security/smtp-tls-check.mjs b/scripts/security/smtp-tls-check.mjs
new file mode 100644
index 0000000..7568923
--- /dev/null
+++ b/scripts/security/smtp-tls-check.mjs
@@ -0,0 +1,89 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { createServer } from 'node:net';
+import { createTransport } from 'nodemailer';
+
+const commands = [];
+const server = createServer((socket) => {
+  socket.setTimeout(3000, () => socket.destroy());
+  socket.write('220 synthetic.local ESMTP\r\n');
+  let buffer = '';
+  socket.on('data', (chunk) => {
+    buffer += chunk.toString();
+    while (buffer.includes('\r\n')) {
+      const end = buffer.indexOf('\r\n');
+      const line = buffer.slice(0, end);
+      buffer = buffer.slice(end + 2);
+      const command = line.split(' ')[0].toUpperCase();
+      commands.push(command);
+      if (command === 'EHLO' || command === 'HELO') {
+        socket.write('250 synthetic.local\r\n');
+      } else if (command === 'QUIT') {
+        socket.end('221 bye\r\n');
+      } else {
+        socket.write('502 unavailable\r\n');
+      }
+    }
+  });
+});
+
+server.listen(0, '127.0.0.1');
+await once(server, 'listening');
+const saved = { ...process.env };
+try {
+  const host = '127.0.0.1';
+  const port = server.address().port;
+  const plaintext = createTransport({ host, port, secure: false, ignoreTLS: true });
+  assert.equal(await plaintext.verify(), true, 'synthetic SMTP fixture must accept plaintext');
+  plaintext.close();
+
+  Object.assign(process.env, {
+    NEXT_PRIVATE_SMTP_HOST: host,
+    NEXT_PRIVATE_SMTP_PORT: String(port),
+    NEXT_PRIVATE_SMTP_SECURE: 'false',
+    NEXT_PRIVATE_SMTP_REQUIRE_TLS: 'true',
+    NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS: 'true',
+    NEXT_PRIVATE_SMTP_APIKEY: 'synthetic',
+  });
+  const { buildTransport } = await import('../../packages/email/transports/build-transport.ts');
+  const configs = [
+    { type: 'SMTP_API', host, port, secure: false, apiKey: 'synthetic' },
+    { type: 'SMTP_AUTH', host, port, secure: false, ignoreTLS: true },
+  ];
+  const transports = configs.map(buildTransport);
+  for (const type of ['smtp-auth', 'smtp-api']) {
+    process.env.NEXT_PRIVATE_SMTP_TRANSPORT = type;
+    const { mailer } = await import(`../../packages/email/mailer.ts?synthetic=${type}`);
+    transports.push(mailer);
+  }
+  commands.length = 0;
+  for (const transport of transports) {
+    try {
+      assert.equal(transport.options.requireTLS, true);
+      assert.notEqual(transport.options.ignoreTLS, true);
+      await assert.rejects(transport.verify(), (error) => error.code === 'ETLS' && error.command === 'STARTTLS');
+    } finally {
+      transport.close();
+    }
+  }
+  assert.equal(commands.filter((command) => command === 'STARTTLS').length, 4);
+  assert.ok(!commands.some((command) => ['AUTH', 'MAIL', 'RCPT', 'DATA'].includes(command)));
+  delete process.env.NEXT_PRIVATE_SMTP_REQUIRE_TLS;
+  for (const config of configs) {
+    const transport = buildTransport(config);
+    assert.equal(transport.options.requireTLS, false);
+    if (config.type === 'SMTP_AUTH') {
+      assert.equal(transport.options.ignoreTLS, true);
+    }
+    transport.close();
+  }
+  console.log(JSON.stringify({ smtpTlsRequiredPaths: 4, plaintextRejected: true, externalEmailSent: false }));
+} finally {
+  for (const name of Object.keys(process.env)) {
+    if (!(name in saved)) {
+      delete process.env[name];
+    }
+  }
+  Object.assign(process.env, saved);
+  await new Promise((resolve, reject) => server.close((error) => (error ? reject(error) : resolve())));
+}
diff --git a/scripts/security/zod-size-gate-check.mjs b/scripts/security/zod-size-gate-check.mjs
new file mode 100644
index 0000000..d238171
--- /dev/null
+++ b/scripts/security/zod-size-gate-check.mjs
@@ -0,0 +1,84 @@
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+
+for (const [name, { z }] of [
+  ['CommonJS', require('zod')],
+  ['ESM', await import('zod')],
+  ['CommonJS v4', require('zod/v4')],
+  ['ESM v4', await import('zod/v4')],
+]) {
+  const oversized = Array(20_000).fill(0);
+  for (const schema of [z.array(z.string()).max(1), z.array(z.string()).length(1)]) {
+    const result = schema.safeParse(oversized);
+    assert.equal(result.success, false);
+    assert.equal(result.error.issues.length, 1);
+    assert.equal(result.error.issues[0].code, 'too_big');
+  }
+
+  let parsed = 0;
+  const element = z.string().transform((value) => {
+    parsed += 1;
+    return value;
+  });
+  const bounded = z.array(element).max(1);
+  assert.equal(bounded.safeParse(Array(20_000).fill('valid element')).success, false);
+  assert.equal((await bounded.safeParseAsync(Array(20_000).fill('valid element'))).success, false);
+  assert.equal(parsed, 0);
+
+  const set = z
+    .set(z.string())
+    .max(1)
+    .safeParse(new Set(oversized.map((_, index) => index)));
+  assert.equal(set.success, false);
+  assert.equal(set.error.issues.length, 1);
+  assert.equal(set.error.issues[0].code, 'too_big');
+
+  const nested = z.object({ values: z.array(z.string()).max(1) }).safeParse({ values: oversized });
+  assert.deepEqual(nested.error.issues[0].path, ['values']);
+  assert.equal(z.array(z.string()).min(2).safeParse(['valid']).error.issues[0].code, 'too_small');
+  assert.deepEqual(z.array(z.number()).max(3).parse([1, 2]), [1, 2]);
+  assert.deepEqual(z.preprocess((value) => value.slice(0, 2), z.array(z.number()).max(2)).parse([1, 2, 3]), [1, 2]);
+  assert.equal(z.array(z.number()).parse(oversized).length, oversized.length);
+  assert.equal(
+    z.array(z.string()).max(1, { message: 'synthetic cap' }).safeParse(oversized).error.issues[0].message,
+    'synthetic cap',
+  );
+  const fallback = z.array(z.string()).max(1).catch(['fallback']);
+  assert.deepEqual(fallback.parse(['a', 'b']), ['fallback']);
+  assert.deepEqual(await fallback.parseAsync(['a', 'b']), ['fallback']);
+  for (const caught of [fallback, fallback.optional(), fallback.default(['default'])]) {
+    let refined = 0;
+    const rejected = caught.refine(() => {
+      refined += 1;
+      return false;
+    });
+    assert.equal(rejected.safeParse(['a', 'b']).success, false);
+    assert.equal((await rejected.safeParseAsync(['a', 'b'])).success, false);
+    assert.equal(refined, 2);
+  }
+  if (name.endsWith('v4')) {
+    const map = z
+      .map(z.string(), z.string())
+      .check(z.maxSize(1))
+      .safeParse(new Map(oversized.map((_, index) => [index, index])));
+    assert.equal(map.success, false);
+    assert.equal(map.error.issues.length, 1);
+    assert.equal(map.error.issues[0].code, 'too_big');
+    assert.deepEqual(
+      z
+        .array(z.number())
+        .overwrite((values) => values.slice(0, 2))
+        .max(2)
+        .parse([1, 2, 3]),
+      [1, 2],
+    );
+    const overwritten = fallback.overwrite(() => []);
+    assert.deepEqual(overwritten.parse(['a', 'b']), []);
+    assert.deepEqual(await overwritten.parseAsync(['a', 'b']), []);
+  }
+  console.log(
+    JSON.stringify({ module: name, oversizedEntries: oversized.length, boundedIssues: 1, parsedElements: parsed }),
+  );
+}
