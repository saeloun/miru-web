diff --git a/scripts/security/zod-size-gate-check.mjs b/scripts/security/zod-size-gate-check.mjs
new file mode 100644
index 0000000..24532f3
--- /dev/null
+++ b/scripts/security/zod-size-gate-check.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+
+for (const [name, { z }] of [
+  ['CommonJS', require('zod')],
+  ['ESM', await import('zod')],
+  ['CommonJS v4', require('zod/v4')],
+  ['ESM v4', await import('zod/v4')],
+]) {
+  const oversized = Array(20_000).fill(0);
+  for (const schema of [z.array(z.string()).max(1), z.array(z.string()).length(1)]) {
+    const result = schema.safeParse(oversized);
+    assert.equal(result.success, false);
+    assert.equal(result.error.issues.length, 1);
+    assert.equal(result.error.issues[0].code, 'too_big');
+  }
+
+  let parsed = 0;
+  const element = z.string().transform(value => { parsed += 1; return value; });
+  const bounded = z.array(element).max(1);
+  assert.equal(bounded.safeParse(Array(20_000).fill('valid element')).success, false);
+  assert.equal((await bounded.safeParseAsync(Array(20_000).fill('valid element'))).success, false);
+  assert.equal(parsed, 0);
+
+  const set = z.set(z.string()).max(1).safeParse(new Set(oversized.map((_, index) => index)));
+  assert.equal(set.success, false);
+  assert.equal(set.error.issues.length, 1);
+  assert.equal(set.error.issues[0].code, 'too_big');
+
+  const nested = z.object({ values: z.array(z.string()).max(1) }).safeParse({ values: oversized });
+  assert.deepEqual(nested.error.issues[0].path, ['values']);
+  assert.equal(z.array(z.string()).min(2).safeParse(['valid']).error.issues[0].code, 'too_small');
+  assert.deepEqual(z.array(z.number()).max(3).parse([1, 2]), [1, 2]);
+  assert.deepEqual(z.preprocess(value => value.slice(0, 2), z.array(z.number()).max(2)).parse([1, 2, 3]), [1, 2]);
+  assert.equal(z.array(z.number()).parse(oversized).length, oversized.length);
+  assert.equal(z.array(z.string()).max(1, { message: 'synthetic cap' }).safeParse(oversized).error.issues[0].message, 'synthetic cap');
+  if (name.endsWith('v4')) {
+    const map = z.map(z.string(), z.string()).check(z.maxSize(1)).safeParse(new Map(oversized.map((_, index) => [index, index])));
+    assert.equal(map.success, false);
+    assert.equal(map.error.issues.length, 1);
+    assert.equal(map.error.issues[0].code, 'too_big');
+    assert.deepEqual(z.array(z.number()).overwrite(values => values.slice(0, 2)).max(2).parse([1, 2, 3]), [1, 2]);
+  }
+  console.log(JSON.stringify({ module: name, oversizedEntries: oversized.length, boundedIssues: 1, parsedElements: parsed }));
+}
diff --git a/scripts/security/mailchannels-transport-check.mjs b/scripts/security/mailchannels-transport-check.mjs
new file mode 100644
index 0000000..b360fd3
--- /dev/null
+++ b/scripts/security/mailchannels-transport-check.mjs
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { createTransport } from 'nodemailer';
+
+import { MailChannelsTransport } from '../../packages/email/transports/mailchannels.ts';
+
+const requests = [];
+let responseStatus = 202;
+const server = createServer(async (request, response) => {
+  const chunks = [];
+  for await (const chunk of request) {
+    chunks.push(chunk);
+  }
+  requests.push({ method: request.method, body: JSON.parse(Buffer.concat(chunks).toString()) });
+  response.writeHead(responseStatus, { 'Content-Type': 'application/json' });
+  response.end(JSON.stringify({ message: 'synthetic transport response' }));
+});
+
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+try {
+  const transport = createTransport(MailChannelsTransport.makeTransport({
+    endpoint: `http://127.0.0.1:${server.address().port}/send`,
+  }));
+  const message = {
+    from: { name: 'Synthetic Sender', address: 'sender@example.test' },
+    to: 'Consultants: First <first@example.test>, Second <second@example.test>;',
+    cc: 'copy@example.test',
+    bcc: 'private@example.test',
+    replyTo: { name: 'Reply Desk', address: 'reply@example.test' },
+    subject: 'Synthetic transport check',
+    text: 'No external email is sent.',
+    headers: { 'X-Synthetic-Check': 'yes' },
+  };
+  const result = await transport.sendMail(message);
+  assert.deepEqual(result.envelope, {
+    from: 'sender@example.test',
+    to: ['first@example.test', 'second@example.test', 'copy@example.test', 'private@example.test'],
+  });
+  assert.deepEqual(result.accepted, result.envelope.to);
+  assert.match(result.messageId, /^<.+>$/);
+  const request = requests[0];
+  assert.equal(request.method, 'POST');
+  assert.deepEqual(request.body.from, { email: 'sender@example.test', name: 'Synthetic Sender' });
+  assert.deepEqual(request.body.reply_to, { email: 'reply@example.test', name: 'Reply Desk' });
+  assert.deepEqual(request.body.personalizations[0].to, [
+    { email: 'first@example.test', name: 'First' },
+    { email: 'second@example.test', name: 'Second' },
+  ]);
+  assert.equal(request.body.personalizations[0].cc[0].email, 'copy@example.test');
+  assert.equal(request.body.personalizations[0].bcc[0].email, 'private@example.test');
+  assert.equal(request.body.headers['X-Synthetic-Check'], 'yes');
+  assert.equal(request.body.content[0].value, message.text);
+
+  responseStatus = 500;
+  await assert.rejects(transport.sendMail(message), /MailChannels error: synthetic transport response/);
+  await assert.rejects(transport.sendMail({ from: message.from, text: message.text }), /Missing required fields/);
+  assert.equal(requests.length, 2);
+  console.log(JSON.stringify({ transport: 'custom HTTP', acceptedRecipients: 4, errorPaths: 2 }));
+} finally {
+  await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+}
diff --git a/scripts/security/dependency-guards-check.mts b/scripts/security/dependency-guards-check.mts
new file mode 100644
index 0000000..9e1ea56
--- /dev/null
+++ b/scripts/security/dependency-guards-check.mts
@@ -0,0 +1,73 @@
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { deepmerge } from 'deepmerge-ts';
+import { generateSchema } from '@anatine/zod-openapi';
+import { z } from 'zod';
+
+const require = createRequire(import.meta.url);
+const prismaRequire = createRequire(require.resolve('@prisma/config'));
+const openApiRequire = createRequire(require.resolve('@anatine/zod-openapi'));
+const typographyRequire = createRequire(require.resolve('@tailwindcss/typography'));
+const failures: string[] = [];
+
+const check = (name: string, run: () => void) => {
+  try {
+    run();
+    console.log(JSON.stringify({ name, passed: true }));
+  } catch (error) {
+    failures.push(name);
+    console.error(JSON.stringify({ name, passed: false, error: error instanceof Error ? error.name : 'Error' }));
+  }
+};
+
+for (const [name, merge] of [
+  ['deepmerge-ts ESM', deepmerge],
+  ['deepmerge-ts CJS', prismaRequire('deepmerge-ts').deepmerge],
+] as const) {
+  check(name, () => {
+    const left: Record<string, unknown> = { schema: './schema.prisma' };
+    const right: Record<string, unknown> = { migrations: { path: './migrations' } };
+    left.self = left;
+    right.self = right;
+    const merged = merge(left, right);
+    assert.equal(merged.schema, './schema.prisma');
+    assert.deepEqual(merged.migrations, { path: './migrations' });
+    assert.equal(merged.self, merged);
+  });
+}
+
+check('OpenAPI merge prototype methods', () => {
+  const { merge } = openApiRequire('ts-deepmerge');
+  const merged = merge({ nested: { left: 1 } }, JSON.parse('{"nested":{"right":2},"toString":"invalid","valueOf":"invalid"}'));
+  assert.deepEqual(merged.nested, { left: 1, right: 2 });
+  assert.equal(typeof merged.toString, 'function');
+  assert.equal(typeof merged.valueOf, 'function');
+  assert.equal(merged.toString(), '[object Object]');
+});
+
+check('OpenAPI schema consumer', () => {
+  assert.deepEqual(generateSchema(z.object({
+    name: z.string().min(2).describe('Name'),
+    active: z.boolean().default(true),
+  })), {
+    type: 'object',
+    properties: {
+      name: { type: 'string', minLength: 2, description: 'Name' },
+      active: { default: true, type: 'boolean' },
+    },
+    required: ['name'],
+  });
+});
+
+check('Typography selector parser patch', () => {
+  const parser = typographyRequire('postcss-selector-parser');
+  const [major, minor, patch] = typographyRequire('postcss-selector-parser/package.json').version.split('.').map(Number);
+  assert.ok((major === 6 && (minor > 1 || (minor === 1 && patch >= 5))) ||
+    (major === 7 && (minor > 1 || (minor === 1 && patch >= 6))) || major > 7);
+  const count = 12_000;
+  const parsed = parser().astSync('.a'.repeat(count));
+  assert.equal(parsed.nodes[0].nodes.length, count);
+  assert.equal(parsed.toString(), '.a'.repeat(count));
+});
+
+assert.deepEqual(failures, [], `Dependency guards failed: ${failures.join(', ')}`);
