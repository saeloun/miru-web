+      embedFont: false,
+    },
+  );
+  assert.ok(svg.startsWith('<svg'));
+  assert.ok(svg.includes('width="1200" height="630"'));
+  assert.ok(svg.includes('synthetic'));
+  assert.ok(!svg.includes('<path data-pwned="true"'));
+  assert.ok(svg.includes('fill="red&quot;/&gt;&lt;path data-pwned=&quot;true&quot;/&gt;&lt;text fill=&quot;red"'));
+  const { svgToPng } = await import('../../packages/lib/utils/images/svg-to-png.ts');
+  const png = await svgToPng(svg);
+  const metadata = await require('sharp')(png).metadata();
+  assert.deepEqual([metadata.format, metadata.width, metadata.height], ['png', 1200, 630]);
+});
+
+assert.deepEqual(failures, [], `Dependency refresh guards failed: ${failures.join(', ')}`);
