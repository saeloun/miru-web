+
+await check('Satori compression dependency round-trips ZIP content', () => {
+  const satoriRequire = createRequire(require.resolve('satori'));
+  const { strToU8, strFromU8, zipSync, unzipSync } = satoriRequire('fflate');
+  const archive = zipSync({ 'synthetic.txt': strToU8('synthetic signing document') });
+  const restored = unzipSync(archive);
+  assert.deepEqual(Object.keys(restored), ['synthetic.txt']);
+  assert.equal(strFromU8(restored['synthetic.txt']), 'synthetic signing document');
+});
+
+await check('Satori escapes SVG attributes and renders the share font', async () => {
+  const { default: satori } = await import('satori');
+  const font = fs.readFileSync('apps/remix/public/fonts/inter-regular.ttf');
+  const svg = await satori(
+    {
+      type: 'div',
+      props: { style: { color: 'red"/><path data-pwned="true"/><text fill="red' }, children: 'synthetic' },
