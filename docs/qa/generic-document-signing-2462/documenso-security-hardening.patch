+        requests.push({ headers: { ...options.headers }, respond });
+        return Object.assign(new EventEmitter(), { destroy() {}, end() {} });
+      },
+    },
+  }).http;
+  for (const sensitiveHeaders of [['X-API-Key'], runInNewContext("['X-API-Key']")]) {
+    const start = requests.length;
+    const request = http.request('http://origin.invalid/', {
+      sensitiveHeaders,
+      headers: { 'X-API-Key': 'synthetic', 'X-Public': 'preserved' },
