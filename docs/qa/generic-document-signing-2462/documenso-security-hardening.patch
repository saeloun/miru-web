+    );
+    assert.deepEqual(legacyMatches, ['one/two/three/file.txt']);
+    const rimraf = googleRequire('rimraf');
+    assert.equal(await rimraf.rimraf(join(root, '**/*.txt'), { glob: true }), true);
+    assert.deepEqual(await glob('**/*.txt', { cwd: root }), []);
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+await check('Minimatch preprocessing respects its expansion budget', () => {
+  for (const parent of [
+    '@hono/vite-dev-server',
+    'google-gax',
+    'react-email',
+    'rimraf',
+    'remix-flat-routes',
+    '@lingui/cli',
+  ]) {
+    const parentRequire = createRequire(require.resolve(parent));
+    const { Minimatch, minimatch } = parentRequire('minimatch');
+    const matcher = new Minimatch('a/**/../b/c/**/../d/e/**/../f/g', {
+      optimizationLevel: 2,
+      braceExpandMax: 4,
+    });
+    assert.ok(matcher.globParts.length <= 4, `${parent} exceeded the configured expansion budget`);
+    assert.equal(minimatch('app/routes/sign.tsx', '**/*.{ts,tsx}'), true);
+    assert.equal(minimatch('app/routes/sign.rb', '**/*.{ts,tsx}'), false);
+  }
+  assert.equal(typeof require('minimatch'), 'function');
+  assert.equal(require('minimatch/package.json').version, '3.1.5');
