diff --git a/docker/Dockerfile b/docker/Dockerfile
index 22cad2e..b3fb42c 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -81,13 +81,18 @@ COPY --from=builder /app/out/package-lock.json ./package-lock.json
 COPY --from=builder /app/lingui.config.ts ./lingui.config.ts
 COPY --from=builder /app/patches ./patches
 
-RUN npm ci
+RUN npm ci && npm cache clean --force
 
 # Then copy all the source code (as it changes more often)
 COPY --from=builder /app/out/full/ .
 # Finally copy the turbo.json file so that we can run turbo commands
 COPY turbo.json turbo.json
 
+COPY --from=builder /app/scripts/security ./scripts/security
+RUN node scripts/security/zod-size-gate-check.mjs \
+    && node --import tsx scripts/security/mailchannels-transport-check.mjs \
+    && node scripts/security/dependency-guards-check.mts
+
 ENV NODE_OPTIONS="--max-old-space-size=8192"
 
 RUN npx turbo run build --filter=@documenso/remix...
@@ -145,6 +150,9 @@ COPY --from=installer --chown=nodejs:nodejs /app/packages/prisma/migrations ./pa
 RUN npx prisma generate --schema ./packages/prisma/schema.prisma --generator client \
     && npm cache clean --force
 
+USER root
+RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
+USER nodejs
 
 # Get the start script from docker/
 COPY --chown=nodejs:nodejs ./docker/start.sh /app/apps/remix/start.sh
