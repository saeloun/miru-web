diff --git a/scripts/security/share-image-check.mjs b/scripts/security/share-image-check.mjs
new file mode 100644
index 0000000..1280a62
--- /dev/null
+++ b/scripts/security/share-image-check.mjs
@@ -0,0 +1,103 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { once } from 'node:events';
+import http from 'node:http';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { build } from 'esbuild';
+import satori from 'satori';
+import sharp from 'sharp';
+
+const root = process.cwd();
+const publicRoot = join(root, 'apps/remix/public');
+const scratch = fs.mkdtempSync(join(root, '.share-image-check-'));
+const requestedPaths = [];
+const server = http.createServer((request, response) => {
+  const allowed = ['/fonts/inter-semibold.ttf', '/fonts/inter-regular.ttf', '/fonts/caveat-regular.ttf'];
+  requestedPaths.push(request.url);
+  response.writeHead(allowed.includes(request.url) ? 200 : 404);
+  response.end(allowed.includes(request.url) ? fs.readFileSync(join(publicRoot, request.url)) : 'Not found');
+});
+
+try {
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  const output = join(scratch, 'route.mjs');
+  await build({
+    entryPoints: [join(root, 'apps/remix/app/routes/_share+/share.$slug.opengraph.tsx')],
+    outfile: output,
+    bundle: true,
+    format: 'esm',
+    platform: 'node',
+    packages: 'external',
+    jsx: 'automatic',
+    plugins: [
+      {
+        name: 'synthetic-share-boundaries',
+        setup(builder) {
+          builder.onResolve(
+            {
+              filter:
+                /^@documenso\/lib\/(constants\/app|server-only\/document\/get-recipient-or-sender-by-share-link-slug)$/,
+            },
+            ({ path }) => ({ path, namespace: 'fixture' }),
+          );
+          builder.onLoad({ filter: /.*/, namespace: 'fixture' }, ({ path }) => ({
+            contents: path.endsWith('/app')
+              ? `export const NEXT_PUBLIC_WEBAPP_URL = () => ${JSON.stringify(origin)};`
+              : 'export const getRecipientOrSenderByShareLinkSlug = async () => globalThis.__shareImageRecord;',
+          }));
+          builder.onResolve({ filter: /^@documenso\/lib\/utils\/images\/svg-to-png$/ }, () => ({
+            path: join(root, 'packages/lib/utils/images/svg-to-png.ts'),
+          }));
+        },
+      },
+    ],
+  });
+  const { loader } = await import(pathToFileURL(output).href);
+  process.chdir(join(root, 'apps/remix'));
+  const signature = await sharp({ create: { width: 64, height: 24, channels: 4, background: '#000000' } })
+    .png()
+    .toBuffer();
+  for (const signatureImage of [null, `data:image/png;base64,${signature.toString('base64')}`]) {
+    globalThis.__shareImageRecord = {
+      name: 'Synthetic Signer',
+      email: 'signer@example.test',
+      signature: signatureImage,
+    };
+    const response = await loader({ params: { slug: 'synthetic-share' } });
+    assert.equal(response.status, 200);
+    assert.equal(response.headers.get('Content-Type'), 'image/png');
+    const bytes = Buffer.from(await response.arrayBuffer());
+    const image = await sharp(bytes).metadata();
+    assert.deepEqual([image.format, image.width, image.height], ['png', 1200, 630]);
+    assert.equal(Number(response.headers.get('Content-Length')), bytes.length);
+  }
+  assert.ok(requestedPaths.every((path) => path.startsWith('/fonts/')));
+  assert.equal((await loader({ params: { slug: 'qr_synthetic' } })).status, 404);
+  globalThis.__shareImageRecord = { error: true };
+  assert.equal((await loader({ params: { slug: 'missing-synthetic' } })).status, 404);
+  await assert.rejects(
+    satori(
+      { type: 'img', props: { src: `${origin}/private.png`, width: 64, height: 24 } },
+      { width: 1200, height: 630, fonts: [] },
+    ),
+    /blocked address.*SSRF protection/,
+  );
+  console.log(
+    JSON.stringify({
+      shareImages: 2,
+      dimensions: [1200, 630],
+      notFoundPaths: 2,
+      ssrfProtection: true,
+      externalRequests: false,
+    }),
+  );
+} finally {
+  delete globalThis.__shareImageRecord;
+  process.chdir(root);
+  server.closeAllConnections();
+  await new Promise((resolve) => server.close(resolve));
+  fs.rmSync(scratch, { recursive: true, force: true });
+}
