+  fs.writeFileSync(join(root, 'static/public.txt'), 'synthetic-public');
+  fs.writeFileSync(join(root, 'static/assets/app.js'), 'synthetic-asset');
+  const app = new Hono();
+  app.use('/static/admin/*', (c) => c.text('Unauthorized', 401));
+  app.use('/static/*', serveStatic({ root }));
+  app.use(
+    '/ESign/*',
+    serveStatic({
+      root,
+      rewriteRequestPath: (path) => path.replace(/^\/ESign/, ''),
+      onFound: (path, c) =>
+        c.header(
+          'Cache-Control',
+          path.startsWith(join(root, 'static/assets'))
+            ? 'public, immutable, max-age=31536000'
+            : 'public, max-age=0, stale-while-revalidate=86400',
+        ),
+    }),
+  );
+  const server = createAdaptorServer(app);
