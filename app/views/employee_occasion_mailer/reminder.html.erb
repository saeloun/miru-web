<% content_for :email_preheader, "An employee occasion is coming up in seven days." %>
<% content_for :email_eyebrow, "Employee occasion reminder" %>
<% content_for :email_title, "Upcoming #{@occasion}" %>
<% content_for :email_subtitle, "#{@employee_name} has a #{@occasion} on #{@event_date}, in seven days." %>
<% if @completed_years %>
  <p><%= @completed_years %> completed <%= "year".pluralize(@completed_years) %> at <%= @company.name %>.</p>
<% end %>
<p>This reminder is enabled by your workspace administrator.</p>
<%= render "shared/mailer/button", href: @profile_url, label: "View employee record" %>
