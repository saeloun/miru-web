<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="referrer" content="no-referrer">
    <%= csrf_meta_tags %>
    <title><%= @error ? "Invitation unavailable" : "Accept invitation" %> | Miru</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; padding: 24px; background: var(--background, #fafafb); color: var(--foreground, #27272a); font: 16px/1.5 system-ui, sans-serif; }
      main { max-width: 480px; margin: 10vh auto; padding: 32px; background: var(--card, white); border: 1px solid var(--border, #e4e4e7); border-radius: 12px; overflow-wrap: anywhere; }
      h1 { font-size: 24px; line-height: 1.3; }
      .brand { font-weight: 700; color: var(--primary, #5b34ea); }
      .muted { color: var(--muted-foreground, #52525b); }
      button { width: 100%; min-height: 44px; padding: 12px 16px; border: 0; border-radius: 6px; background: var(--primary, #5b34ea); color: white; font: inherit; font-weight: 600; cursor: pointer; }
      a { color: var(--primary, #5b34ea); }
      button:focus-visible, a:focus-visible { outline: 3px solid var(--ring, #5b34ea); outline-offset: 4px; }
      @media (max-width: 480px) { main { padding: 24px; margin-top: 32px; } }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">Miru</p>
      <% if @error %>
        <h1>Invitation unavailable</h1>
        <p role="alert"><%= @error %></p>
        <p><%= link_to "Back to Miru", root_path %></p>
      <% else %>
        <h1>Join <%= @invitation.company.name %></h1>
        <p>You have been invited as <strong><%= @invitation.role.humanize %></strong> for <strong><%= @invitation.recipient_email %></strong>.</p>
        <p class="muted">Accept to join this workspace. New members will set a password next; existing members can use their usual sign-in.</p>
        <%= form_with url: invitations_accepts_path, method: :post, local: true do |form| %>
          <%= form.hidden_field :token, value: @invitation.token %>
          <%= form.button "Accept invitation", type: "submit" %>
        <% end %>
        <p class="muted">If you were not expecting this invitation, close this page.</p>
      <% end %>
    </main>
  </body>
</html>
